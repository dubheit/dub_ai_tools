<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ollama" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ollama</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dub_ai_base.res_config_settings_view_form_ai_base"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='providers_activation']" position="after">
                <block title="Ollama" name="ollama_config">
                    <setting string="Ollama Configuration" help="Configure Ollama server settings (OpenAI-compatible API)">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="dub_ai_ollama_base_url" string="Base URL" class="col-lg-3"/>
                                <field name="dub_ai_ollama_base_url" placeholder="http://localhost:11434" class="w-50"/>
                            </div>
                            <div class="row mt16">
                                <label for="dub_ai_ollama_api_key" string="API Key" class="col-lg-3"/>
                                <field name="dub_ai_ollama_api_key" placeholder="Optional" class="w-50" password="True"/>
                            </div>
                            <div class="row mt16">
                                <label for="dub_ai_ollama_model_id" string="Model" class="col-lg-3"/>
                                <field name="dub_ai_ollama_model_id" class="w-50" options="{'no_create': True}" domain="[('provider', '=', 'ollama'), ('active', '=', True)]"/>
                            </div>
                            <div class="row mt16">
                                <label for="dub_ai_ollama_temperature" string="Temperature" class="col-lg-3"/>
                                <field name="dub_ai_ollama_temperature" class="w-25"/>
                            </div>
                            <div class="mt16">
                                <button name="action_sync_ollama" type="object" string="Sync Models" class="btn-secondary" icon="fa-refresh"/> <button name="action_test_ollama" type="object" string="Test Connection" class="btn-secondary" icon="fa-heartbeat"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

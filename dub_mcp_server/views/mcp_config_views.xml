<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mcp_server_config_form" model="ir.ui.view">
    <field name="name">mcp.server.config.form</field>
    <field name="model">mcp.server.config</field>
    <field name="arch" type="xml">
      <form string="MCP Server Configuration">
        <sheet>
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="active" invisible="1"/>
              <field
                name="oauth2_client_id"
                options="{'no_create': True}"
              />
            </group>
          </group>
          <group>
            <group string="Transport">
              <field name="transport_http"/>
              <field name="transport_stdio"/>
            </group>
            <group string="Limits">
              <field name="max_page_size"/>
              <field name="default_page_size"/>
              <field name="request_timeout_ms"/>
              <field name="request_body_max_kb"/>
            </group>
            <group string="Rate Limiting">
              <field name="rate_limit_window_s"/>
              <field name="rate_limit_max_requests"/>
            </group>
            <group string="Logging">
              <field name="enable_audit_log"/>
              <field name="audit_retention_days" invisible="not enable_audit_log"/>
              <field name="allow_logs_tool"/>
            </group>
          </group>
          <notebook>
            <page string="Model Rules">
              <field name="rule_ids">
                <list>
                  <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="model_name" column_invisible="1"/>
                  <field name="allow_read"/>
                  <field name="allow_create"/>
                  <field name="allow_write"/>
                  <field name="allow_unlink"/>
                  <field name="require_confirmation" optional="show"/>
                  <field name="allowed_method_ids" widget="many2many_tags" optional="show"/>
                  <field name="description" optional="hide"/>
                </list>
                <form string="Model Rule">
                  <sheet>
                    <group>
                      <group string="Model">
                        <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="model_name" invisible="1"/>
                      </group>
                      <group string="CRUD Permissions">
                        <field name="allow_read"/>
                        <field name="allow_create"/>
                        <field name="allow_write"/>
                        <field name="allow_unlink"/>
                        <field name="require_confirmation"/>
                      </group>
                    </group>
                    <group string="Restrictions">
                      <field name="field_denylist" placeholder="field1, field2, ..."/>
                      <field name="domain_restriction" placeholder='[("active", "=", True)]'/>
                      <field name="description"/>
                    </group>
                    <group string="PII Masking" invisible="not model_id">
                      <field name="pii_mask_field_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <separator string="Allowed Methods" invisible="not model_id"/>
                    <div invisible="not model_id" class="mb-3">
                      <button name="action_refresh_methods" type="object" string="⟳ Refresh Available Methods" class="btn btn-secondary"/>
                    </div>
                    <group invisible="not model_id">
                      <field name="allowed_method_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mcp_server_config_tree" model="ir.ui.view">
    <field name="name">mcp.server.config.list</field>
    <field name="model">mcp.server.config</field>
    <field name="arch" type="xml">
      <list string="MCP Server Configurations">
        <field name="name"/>
        <field name="oauth2_client_id"/>
        <field name="active" column_invisible="1"/>
        <field name="transport_http"/>
      </list>
    </field>
  </record>

  <record id="view_mcp_server_config_search" model="ir.ui.view">
    <field name="name">mcp.server.config.search</field>
    <field name="model">mcp.server.config</field>
    <field name="arch" type="xml">
      <search string="MCP Server Configurations">
        <field name="name"/>
        <field name="oauth2_client_id"/>
        <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_mcp_server_config" model="ir.actions.act_window">
    <field name="name">MCP Server</field>
    <field name="res_model">mcp.server.config</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Audit Log Views -->
  <record id="view_mcp_server_audit_tree" model="ir.ui.view">
    <field name="name">mcp.server.audit.list</field>
    <field name="model">mcp.server.audit</field>
    <field name="arch" type="xml">
      <list string="MCP Audit Log" create="false" edit="false" delete="false">
        <field name="timestamp"/>
        <field name="user_id"/>
        <field name="operation"/>
        <field name="model_name"/>
        <field name="record_ids"/>
        <field name="status" decoration-success="status == 'success'" decoration-danger="status in ('fail', 'denied')" decoration-warning="status in ('timeout', 'rate_limited')"/>
        <field name="ip_address" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_mcp_server_audit_form" model="ir.ui.view">
    <field name="name">mcp.server.audit.form</field>
    <field name="model">mcp.server.audit</field>
    <field name="arch" type="xml">
      <form string="MCP Audit Entry" create="false" edit="false" delete="false">
        <sheet>
          <group>
            <group string="Request">
              <field name="timestamp"/>
              <field name="user_id"/>
              <field name="ip_address"/>
              <field name="transport"/>
            </group>
            <group string="Operation">
              <field name="operation"/>
              <field name="model_name"/>
              <field name="record_ids"/>
              <field name="status"/>
            </group>
          </group>
          <notebook>
            <page string="Request Excerpt">
              <field name="request_excerpt" readonly="1"/>
            </page>
            <page string="Error" invisible="not error_excerpt">
              <field name="error_excerpt" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mcp_server_audit_search" model="ir.ui.view">
    <field name="name">mcp.server.audit.search</field>
    <field name="model">mcp.server.audit</field>
    <field name="arch" type="xml">
      <search string="MCP Audit Log">
        <field name="user_id"/>
        <field name="model_name"/>
        <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
        <filter string="Failed" name="failed" domain="[('status', 'in', ('fail', 'denied', 'timeout', 'rate_limited'))]"/>
        <filter string="Today" name="today" domain="[('timestamp', '&gt;=', context_today())]"/>
      </search>
    </field>
  </record>

  <record id="action_mcp_server_audit" model="ir.actions.act_window">
    <field name="name">Audit Log</field>
    <field name="res_model">mcp.server.audit</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_today': 1}</field>
  </record>

  <menuitem id="menu_mcp_root" name="MCP Server" parent="base.menu_custom" groups="dub_mcp_server.group_mcp_manager" sequence="1000"/>
  <menuitem id="menu_mcp_config" name="Configuration" parent="menu_mcp_root" action="action_mcp_server_config" groups="dub_mcp_server.group_mcp_manager"/>
  <menuitem id="menu_mcp_audit" name="Audit Log" parent="menu_mcp_root" action="action_mcp_server_audit" groups="dub_mcp_server.group_mcp_manager"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mistral" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mistral</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dub_ai_base.res_config_settings_view_form_ai_base"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='providers_activation']" position="after">
                <block title="Mistral AI" name="mistral_config">
                    <setting string="Mistral Configuration" help="Configure Mistral AI API settings">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="dub_ai_mistral_api_key" string="API Key" class="col-lg-3"/>
                                <field name="dub_ai_mistral_api_key" placeholder="xxxxxxx" class="w-50" password="True"/>
                            </div>
                            <div class="row mt16">
                                <label for="dub_ai_mistral_model_id" string="Model" class="col-lg-3"/>
                                <field name="dub_ai_mistral_model_id" class="w-50" options="{'no_create': True}" domain="[('provider', '=', 'mistral'), ('active', '=', True)]"/>
                            </div>
                            <div class="row mt16">
                                <label for="dub_ai_mistral_temperature" string="Temperature" class="col-lg-3"/>
                                <field name="dub_ai_mistral_temperature" class="w-25"/>
                            </div>
                            <div class="mt16">
                                <button name="action_sync_mistral" type="object" string="Sync Models" class="btn-secondary" icon="fa-refresh"/> <button name="action_test_mistral" type="object" string="Test Connection" class="btn-secondary" icon="fa-heartbeat"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

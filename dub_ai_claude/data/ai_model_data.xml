<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Deliberately updatable, unlike the other providers' catalogues: the
         per-route identifiers below are facts about the platforms, not user
         data, and a stale mapping fails at call time with a confusing error.
         An upgrade rewrites only the fields declared here, so archiving a
         model, or adding your own, survives it. -->

    <!-- One identifier per route: the Anthropic API id in "name", the
         Bedrock Messages-API endpoint in "bedrock_model_id", the Bedrock EU
         cross-region inference profile in "bedrock_invoke_model_id". On
         Google Cloud the id matches "name" for every model below, so
         "vertex_model_id" stays empty.

         The empty cells are deliberate. Sonnet 4.6 is not served by the
         Bedrock Messages-API endpoint, only by InvokeModel. Fable 5.1 has no
         EU inference profile, only a global one, so it is unusable on the
         InvokeModel route while data must stay in the EU.

         Which models an AWS account can actually reach differs per endpoint
         and region: list them with the AWS CLI command
         "bedrock list-inference-profiles" for the region you use. -->

    <record id="ai_model_claude_opus_55" model="dub.ai.model">
        <field name="name">claude-opus-5-5</field>
        <field name="display_name">Claude Opus 5.5</field>
        <field name="provider">claude</field>
        <field name="bedrock_invoke_model_id">eu.anthropic.claude-opus-5-5</field>
        <field name="bedrock_model_id">anthropic.claude-opus-5-5</field>
        <field name="supports_vision" eval="True"/>
        <field name="supports_tools" eval="True"/>
        <field name="max_output_tokens">128000</field>
        <field name="sequence">1</field>
    </record>
